# Free self-hosted Postgres (see docker-compose.yml)
DATABASE_URL=postgres://customfolio:customfolio@localhost:5432/customfolio
HOST=0.0.0.0
PORT=8080
DATA_DIR=data/imports
MAX_UPLOAD_BYTES=52428800
# Comma-separated browser origins allowed with session cookies (no wildcards).
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
